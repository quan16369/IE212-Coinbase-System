# Copy this file to .env on the deployment host and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=coinbase_streaming
COMPOSE_PROFILES=ops
LOG_MAX_SIZE=25m
LOG_MAX_FILE=5

KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

CASSANDRA_CLUSTER_NAME=coinbase_cluster
CASSANDRA_KEYSPACE=coinbase
CASSANDRA_PORT=9042
CASSANDRA_MAX_HEAP_SIZE=1G
CASSANDRA_HEAP_NEWSIZE=256M

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
AWS_ENDPOINT=http://minio:9000
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
AWS_S3_FORCE_PATH_STYLE=true
S3_BUCKET=ie212-coinbase-data

MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=coinbase-price-forecasting
MLFLOW_REGISTERED_MODEL_NAME=coinbase-price-lightgbm
BENTO_SERVICE_PORT=3001
BENTOML_MODEL_TAG=coinbase_price_lightgbm:latest
# Set after a MLflow model version has been promoted to the champion alias.
# MLOPS_MODEL_URI=models:/coinbase-price-lightgbm@champion
MLOPS_HORIZON=4
MLOPS_FREQ_MINUTES=60
MLOPS_MODEL_OUTPUT=artifacts/mlops/coinbase_ml_model.joblib
# Replace with a mounted path for Compose, or migrate this to object storage in cloud.
MLOPS_TRAINING_CSV=/workspace/Coinbase_Streaming/data/BTCUSDT_5m_full.csv

GCP_PROJECT_ID=CHANGE_ME_GCP_PROJECT
GAR_LOCATION=asia-southeast1
GAR_REPOSITORY=coinbase-mlops
BENTO_LOCAL_IMAGE=coinbase_streaming-bento-price-predictor:latest
BENTO_IMAGE_NAME=coinbase-bento-price-predictor
IMAGE_TAG=
GKE_CLUSTER=CHANGE_ME_GKE_CLUSTER
GKE_REGION=asia-southeast1

JENKINS_PORT=8088
JENKINS_AGENT_PORT=50000
JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=true

SONARQUBE_PORT=9002
SONAR_HOST_URL=CHANGE_ME_SONARQUBE_URL
SONAR_TOKEN=

AIRFLOW_PORT=8089
AIRFLOW_FEATURE_PLATFORM_URL=http://feature-platform:8090
AIRFLOW_TRAINING_CSV=/workspace/Coinbase_Streaming/data/BTCUSDT_5m_full.csv
AIRFLOW_FORCE_RETRAIN=false
AIRFLOW_PROMOTE_MODEL=false

FEATURE_ONLINE_STORE=redis
FEATURE_OFFLINE_STORE=postgres
FEATURE_DATA_VERSION=local-dev
FEATURE_DRIFT_SYMBOL=BTCUSDT
FEATURE_DRIFT_FAIL_ON_DRIFT=false

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_LOG_LEVEL=info

PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
CADVISOR_PORT=8081
LOKI_PORT=3100

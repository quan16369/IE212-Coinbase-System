# Dockerfile for packaging LSTM model as OCI artifact
# Following CNCF ModelPack specification

FROM scratch

# Model metadata
LABEL org.opencontainers.image.title="Crypto LSTM BTC Model"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.description="Simple LSTM model for Bitcoin price prediction"
LABEL org.opencontainers.image.authors="Crypto Pipeline Team"
LABEL org.opencontainers.image.vendor="crypto-pipeline.io"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.created="2025-12-31T00:00:00Z"

# ModelPack annotations
LABEL io.modelpack.framework="pytorch"
LABEL io.modelpack.framework.version="2.0.0"
LABEL io.modelpack.format="pytorch"
LABEL io.modelpack.architecture="lstm-attention"
LABEL io.modelpack.task="time-series-forecasting"
LABEL io.modelpack.domain="cryptocurrency"

# Model performance metrics
LABEL io.modelpack.metrics.mae="0.025"
LABEL io.modelpack.metrics.rmse="0.035"
LABEL io.modelpack.metrics.direction_accuracy="0.65"

# Inference specs
LABEL io.modelpack.inference.latency.p95="10ms"
LABEL io.modelpack.inference.memory="500MB"
LABEL io.modelpack.inference.throughput="100/sec"

# Copy model files
COPY checkpoints/best_epoch_16.pt /model/model.pt
COPY configs/lstm_paimon_config.yaml /model/config.yaml
COPY modelpack.yaml /model/modelpack.yaml

# Copy model source code (for reference)
COPY src/lstm_attention_model.py /model/src/
COPY src/train_lstm_paimon.py /model/src/
COPY src/paimon_data_loader.py /model/src/

# Model metadata as JSON
COPY metadata.json /model/metadata.json

# Scalers and preprocessing (if any)
# COPY scalers.joblib /model/scalers.joblib

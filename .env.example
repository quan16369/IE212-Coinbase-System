# Compose
COMPOSE_PROJECT_NAME=coinbase_streaming
COMPOSE_PROFILES=ops
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Kafka
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Cassandra
CASSANDRA_CLUSTER_NAME=coinbase_cluster
CASSANDRA_KEYSPACE=coinbase
CASSANDRA_PORT=9042
CASSANDRA_MAX_HEAP_SIZE=512M
CASSANDRA_HEAP_NEWSIZE=100M

# MinIO / S3 compatible storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
AWS_ENDPOINT=http://minio:9000
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_S3_FORCE_PATH_STYLE=true
S3_BUCKET=ie212-coinbase-data

# Prediction service
PREDICTION_SERVICE_PORT=8000
PREDICTOR_CASSANDRA_HOSTS=cassandra
PRODUCT_IDS=BTC-USD,ETH-USD,XRP-USD
PREDICTION_INTERVAL=300
MODEL_CONFIG_PATH=/app/model/configs/train_config.yaml
MODEL_CHECKPOINT_PATH=/app/model/checkpoints/best_epoch_16.pt
MODEL_NAME=lstm_model_v1
MODEL_VERSION=1.0
MODEL_TYPE=lstm
DEVICE=cpu
ENABLE_HEALTH_CHECK=true

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_LOG_LEVEL=info

# Ops profile
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
CADVISOR_PORT=8081
LOKI_PORT=3100
